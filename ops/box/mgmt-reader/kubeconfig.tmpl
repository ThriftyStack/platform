apiVersion: v1
kind: Config
clusters:
  - name: management
    cluster:
      server: https://10.0.10.83:6443
      certificate-authority: /home/box/.kube/mgmt-reader/ca.crt
users:
  - name: box-reader
    user:
      tokenFile: /home/box/.kube/mgmt-reader/token
contexts:
  - name: box-reader
    context:
      cluster: management
      user: box-reader
current-context: box-reader
